<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/glass_stroke_focused" />
            <solid android:color="@color/glass_surface_focused" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
            <solid android:color="@color/glass_surface" />
        </shape>
    </item>
</selector>
