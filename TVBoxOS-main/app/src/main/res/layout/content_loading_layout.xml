<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true">

    <com.github.tvbox.osc.ui.tv.widget.HomeLoadingView
        android:id="@+id/contentLoadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="@dimen/vs_8">

        <ImageView
            android:layout_width="@dimen/vs_45"
            android:layout_height="@dimen/vs_45"
            android:contentDescription="@string/app_name"
            android:scaleType="centerInside"
            android:src="@drawable/rannuan_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_12"
            android:text="正在加载内容"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_24"
            android:textStyle="bold" />

    </LinearLayout>
</FrameLayout>
