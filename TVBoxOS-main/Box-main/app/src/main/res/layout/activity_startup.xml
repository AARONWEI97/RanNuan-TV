<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF080810">

    <com.github.tvbox.osc.ui.tv.widget.CinemaSplashView
        android:id="@+id/cinemaSplashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/splashBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="@dimen/vs_40">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="@dimen/vs_80"
            android:layout_height="@dimen/vs_80"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@drawable/rannuan_logo" />

        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_15"
            android:text="@string/app_name"
            android:textColor="#FFFFD68A"
            android:textSize="@dimen/ts_40"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:text="@string/app_tagline"
            android:textColor="#80FBBF24"
            android:textSize="@dimen/ts_18" />
    </LinearLayout>
</FrameLayout>
