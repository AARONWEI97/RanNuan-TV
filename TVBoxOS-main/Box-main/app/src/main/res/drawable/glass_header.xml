<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="18dp" />
            <gradient
                android:angle="90"
                android:endColor="#381E2229"
                android:startColor="#8C20242B" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <shape>
            <corners android:radius="17dp" />
            <stroke android:width="1dp" android:color="@color/glass_highlight" />
        </shape>
    </item>
</layer-list>
