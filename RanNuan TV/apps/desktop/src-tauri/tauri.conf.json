{
  "productName": "RanNuan TV",
  "version": "2.1.0",
  "identifier": "com.ran-nuan.tv",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "node src-tauri/prepare-backend.cjs && pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "冉暖TV",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../server/server.js": "server/server.js",
      "../../../server/actorIndex.js": "server/actorIndex.js",
      "../../../server/package.json": "server/package.json",
      "../../../server/node_modules/": "server/node_modules/",
      "../../../server/node-runtime/": "server/node-runtime/"
    },
    "icon": [
      "icons/icon.ico",      
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
